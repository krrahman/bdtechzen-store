# APP_URL: Public URL of the storefront (injected automatically in Cloud Run)
APP_URL="http://localhost:3000"

# JWT_SECRET: Secret key for signing administrative sessions and customer authentication tokens
JWT_SECRET="bdtechzen_production_signature_key_change_in_production"

# PORT: Server listening port (defaults to 3000)
PORT=3000

# MYSQL DATABASE CONFIGURATION (TiDB Cloud Serverless / Aiven Free MySQL / Railway / cPanel Remote MySQL)
# Option A (Recommended for Cloud MySQL): Paste full connection URI into MYSQL_URL
MYSQL_URL=""
# Option B: Individual MySQL connection parameters
MYSQL_HOST=""
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="bdtechzen_store"
MYSQL_SSL=""

# CUSTOMER EMAIL DISPATCH (SMTP / Transactional Email)
# Leave empty in local development to use automatic Ethereal test relay & outbox logging
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="BDTechZen Studio <orders@bdtechzen.com>"

# BANGLADESH MOBILE SMS GATEWAY (Compatible with BulkSMSBD / SSL Wireless / GreenWeb / MimSMS)
# Leave empty in local development to use automatic SMS outbox logging
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID="BDTechZen"

# BANGLADESH PAYMENT GATEWAYS (MFS & Cards)
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""

NAGAD_MERCHANT_ID=""
NAGAD_PUBLIC_KEY=""
NAGAD_PRIVATE_KEY=""

SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASS=""
